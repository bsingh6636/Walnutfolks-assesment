# Copy to .env and fill in. Never commit .env.

# MySQL 8 connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=walnutfolks

# Hosted MySQL providers require TLS. Set to false for a local MySQL.
DB_SSL=true

# Sockets remain open in the pool between requests. This is an idle recycle
# interval, not how long a request holds its connection.
DB_POOL_MINSIZE=5
DB_POOL_MAXSIZE=30
DB_POOL_RECYCLE_SECONDS=300

# INFO includes HTTP, SQL, pool, and processing timings. DEBUG also logs idle polls.
LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SECONDS=1

# Simulated external-API delay. 30 is what the assessment requires;
# lower it locally to iterate faster.
PROCESSING_DELAY_SECONDS=30

# Most rows one worker claim may take. Every due row becomes one batch:
# one shared wait, then one UPDATE for all of them.
WORKER_BATCH_SIZE=1000
