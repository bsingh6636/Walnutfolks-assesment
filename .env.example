# Copy to .env and fill in. Never commit .env.

# MySQL 8 connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=walnutfolks

# Hosted MySQL providers require TLS. Set to false for a local MySQL.
DB_SSL=true

# Simulated external-API delay. 30 is what the assessment requires;
# lower it locally to iterate faster.
PROCESSING_DELAY_SECONDS=30
